      - family-names: Nagao
        given-names: Yuki
    journal: Macromolecules
    year: 2025
    doi: "10.1021/acs.macromol.4c02607"

  - type: article
    title: >-
      Structure-hydration-transport relationships in alkyl sulfonated
      polyimides: backbone-controlled ordering and proton-transport
